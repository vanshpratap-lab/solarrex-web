{
  "cdn_routing": {
    "provider": "vercel-global-edge",
    "caching_policies": [
      {
        "source": "/assets/(.*)",
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      },
      {
        "source": "/api/(.*)",
        "headers": {
          "Cache-Control": "private, no-cache, no-store, must-revalidate",
          "Pragma": "no-cache",
          "Expires": "0"
        }
      }
    ]
  }
}
